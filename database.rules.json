{
  "rules": {
    "boards": {
      "$pin": {
        ".read": "$pin.matches(/^[0-9]{6}$/)",
        ".write": "!newData.exists()",
        "meta": {
          ".write": "!data.exists()",
          ".validate": "newData.child('clave').isString() && newData.child('clave').val().length === 12"
        },
        "idioma": {
          ".write": true,
          ".validate": "newData.val() === 'es' || newData.val() === 'en'"
        },
        "estado": {
          ".write": true
        },
        "actividades": {
          ".write": true
        },
        "participantes": {
          "$pid": {
            ".write": "!data.exists() || !newData.exists()",
            ".validate": "newData.child('nombre').isString() && newData.child('nombre').val().length >= 1 && newData.child('nombre').val().length <= 16"
          }
        },
        "online": {
          "$pid": {
            ".write": true,
            ".validate": "newData.isBoolean()"
          }
        },
        "respuestas": {
          "$aid": {
            "$pid": {
              ".write": true,
              ".validate": "newData.child('at').val() === now && (!newData.child('texto').exists() || (newData.child('texto').isString() && newData.child('texto').val().length <= 140))",
              "preguntas": {
                "$qid": {
                  ".validate": "newData.child('texto').isString() && newData.child('texto').val().length <= 140"
                }
              }
            }
          }
        },
        "fotos": {
          "$aid": {
            "$pid": {
              ".write": true,
              ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 200000"
            }
          }
        },
        "minis": {
          "$aid": {
            "$pid": {
              ".write": true,
              ".validate": "newData.isString() && newData.val().beginsWith('data:image/jpeg;base64,') && newData.val().length <= 60000"
            }
          }
        },
        "comentarios": {
          "$aid": {
            "$cid": {
              ".write": true,
              ".validate": "newData.child('at').val() === now && newData.child('de').isString() && newData.child('en').isString() && newData.child('texto').isString() && newData.child('texto').val().length >= 1 && newData.child('texto').val().length <= 140"
            }
          }
        },
        "reacciones": {
          "$aid": {
            "$publicacion": {
              "$quien": {
                "$tipo": {
                  ".write": true,
                  ".validate": "newData.isBoolean() && newData.val() === true && ($tipo === 'bien' || $tipo === 'idea' || $tipo === 'duda' || $tipo === 'revisa')"
                }
              }
            }
          }
        },
        "moderacion": {
          ".write": true
        },
        "pizarra": {
          ".write": true
        },
        "clase": {
          ".write": true,
          ".validate": "newData.child('titulo').isString() && newData.child('titulo').val().length <= 60 && (!newData.child('objetivo').exists() || (newData.child('objetivo').isString() && newData.child('objetivo').val().length <= 200))"
        },
        "resumen": {
          ".write": true,
          ".validate": "newData.isString() && newData.val().length === 12"
        }
      }
    },
    "resumenes": {
      "$id": {
        ".read": "data.child('vence').val() > now",
        ".write": "(!data.exists() && newData.child('vence').isNumber() && newData.child('vence').val() > now && newData.child('vence').val() <= now + 1382400000) || (data.exists() && !newData.exists() && data.child('vence').val() <= now)"
      }
    },
    "docentes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
